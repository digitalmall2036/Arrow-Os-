rules_version = '2';

// Each signed-in user can read and write only their own space: users/<their uid>/...
// Paste this into Firebase → Firestore Database → Rules, then tap Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
