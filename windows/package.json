{
  "name": "arrow-os",
  "productName": "Arrow Os",
  "version": "1.0.0",
  "description": "Arrow Os for Windows: an OS inside your laptop, controlled by voice",
  "main": "src/main.js",
  "author": "Mj",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/commands.test.js",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.arrowos.desktop",
    "productName": "Arrow Os",
    "copyright": "Arrow Os",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arrow Os",
      "artifactName": "ArrowOs-Setup.exe"
    },
    "portable": {
      "artifactName": "ArrowOs-Portable.exe"
    }
  }
}
